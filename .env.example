# Copy to .env and adjust. Every variable is optional; defaults are shown.
# Never commit a real .env: it is git-ignored.

# Logging
INVOICE_LOG_LEVEL=INFO
INVOICE_LOG_FORMAT=text           # text | json

# Extraction: rules (local only) | llm | auto (rules first, LLM when incomplete)
INVOICE_EXTRACTOR=rules
INVOICE_CONFIDENCE_THRESHOLD=0.7  # fields below this are highlighted; also triggers the auto fallback
INVOICE_CSV_LOCALE=en             # en | es

# OCR for scanned PDFs (needs the `ocr` extra and Tesseract)
INVOICE_OCR_ENABLED=true
INVOICE_OCR_LANGUAGE=spa          # falls back to eng with a warning when not installed
INVOICE_OCR_DPI=300
# INVOICE_TESSERACT_CMD=/opt/homebrew/bin/tesseract

# LLM extractor. Sends invoice text to the Anthropic API: see "Privacy" in the README.
# It stays off unless INVOICE_LLM_ENABLED=true AND the extractor is llm or auto.
INVOICE_LLM_ENABLED=false
INVOICE_LLM_MODEL=claude-sonnet-5-5
INVOICE_LLM_MAX_TOKENS=2048
# ANTHROPIC_API_KEY=

# Web UI
INVOICE_WEB_HOST=127.0.0.1
INVOICE_WEB_PORT=8000
INVOICE_WEB_MAX_UPLOAD_MB=10
INVOICE_WEB_MAX_FILES=50

# Watch mode: seconds a file must stay unchanged before it is processed
INVOICE_WATCH_SETTLE_SECONDS=1.0
